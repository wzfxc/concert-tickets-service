generator client {
  provider        = "prisma-client"
  output          = "../src/generated"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// CHECK constraints live in raw SQL (migrations); Prisma cannot model them.
model CancelBatch {
  eventId    String    @id @map("event_id") @db.Uuid
  status     String    @default("running")
  total      Int       @default(0)
  done       Int       @default(0)
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)
  event      Event     @relation(fields: [eventId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("cancel_batches")
}

/// CHECK constraints live in raw SQL (migrations); Prisma cannot model them.
model EmailOutbox {
  id          BigInt    @id @default(autoincrement())
  dedupKey    String    @unique @map("dedup_key")
  toEmail     String    @map("to_email")
  subject     String
  body        String
  status      String    @default("pending")
  attempts    Int       @default(0)
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt      DateTime? @map("sent_at") @db.Timestamptz(6)

  @@index([createdAt], map: "email_outbox_due_idx", where: raw("(status = 'pending'::text)"))
  @@map("email_outbox")
}

model EntranceScan {
  id        BigInt   @id @default(autoincrement())
  ticketId  String?  @map("ticket_id") @db.Uuid
  eventId   String?  @map("event_id") @db.Uuid
  gate      String
  scannerId String?  @map("scanner_id") @db.Uuid
  result    String
  scannedAt DateTime @default(now()) @map("scanned_at") @db.Timestamptz(6)
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user      User?    @relation(fields: [scannerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ticket    Ticket?  @relation(fields: [ticketId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([eventId, scannedAt], map: "entrance_scans_event_idx")
  @@map("entrance_scans")
}

model EventController {
  eventId String @map("event_id") @db.Uuid
  userId  String @map("user_id") @db.Uuid
