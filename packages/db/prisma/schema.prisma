/// CHECK constraints live in raw SQL (migrations); Prisma cannot model them.
model Event {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code              String?            @unique
  organizerId       String             @map("organizer_id") @db.Uuid
  venueId           String             @map("venue_id") @db.Uuid
  title             String
  category          String
  city              String
  startsAt          DateTime           @map("starts_at") @db.Timestamptz(6)
  endsAt            DateTime?          @map("ends_at") @db.Timestamptz(6)
  status            EventStatus        @default(draft)
  salesStart        DateTime?          @map("sales_start") @db.Timestamptz(6)
  perUserLimit      Int                @default(6) @map("per_user_limit")
  queueEnabled      Boolean            @default(false) @map("queue_enabled")
  queueLatched      Boolean            @default(false) @map("queue_latched")
  rescheduledAt     DateTime?          @map("rescheduled_at") @db.Timestamptz(6)
  cancelledAt       DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  cancelBatch       CancelBatch?
  entranceScans     EntranceScan[]
  eventControllers  EventController[]
  eventSeatPrices   EventSeatPrice[]
  eventSeq          EventSeq?
  eventZoneCounters EventZoneCounter[]
  eventZonePrices   EventZonePrice[]
  user              User               @relation(fields: [organizerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  venue             Venue              @relation(fields: [venueId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orderItems        OrderItem[]
  orders            Order[]
  promoCodes        PromoCode[]
  queueEntries      QueueEntry[]
  seatEvents        SeatEvent[]
  seatHolds         SeatHold[]
  tickets           Ticket[]
  waitlistEntries   WaitlistEntry[]
  waitlistOffers    WaitlistOffer[]
  zoneHolds         ZoneHold[]

  @@index([category, startsAt], map: "events_category_starts_idx")
  @@index([city, startsAt], map: "events_city_starts_idx")
  @@index([city(ops: raw("gin_trgm_ops"))], map: "events_city_trgm", type: Gin)
  @@index([startsAt], map: "events_on_sale_starts_idx", where: raw("(status = ANY (ARRAY['on_sale'::event_status, 'rescheduled'::event_status]))"))
  @@index([organizerId], map: "events_organizer_idx")
  @@index([startsAt], map: "events_starts_idx")
  @@index([title(ops: raw("gin_trgm_ops"))], map: "events_title_trgm", type: Gin)
  @@map("events")
}

