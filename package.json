{
  "name": "concert-tickets-service",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm build:libs && pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:client": "pnpm --filter @tickets/api export:openapi && pnpm --filter @tickets/web gen:api",
    "test:integration": "pnpm --filter @tickets/tests test",
    "build:libs": "pnpm --filter \"./packages/*\" build"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
