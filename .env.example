# Postgres
POSTGRES_USER=tickets
POSTGRES_PASSWORD=tickets_dev_password
POSTGRES_DB=tickets
DATABASE_URL=postgresql://tickets:tickets_dev_password@postgres:5432/tickets
# Redis
REDIS_URL=redis://redis:6379
# Auth / signing (dev values only - override in real deployments)
JWT_SECRET=dev-jwt-secret-change-me
QR_SIGNING_SECRET=dev-qr-secret-change-me
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret-change-me
SEED_PASSWORD=Passw0rd!
# Payment stub: off | on (chaos: dup/delay<=60s/reorder/drop webhooks, every 10th request 503)
PAYMENT_CHAOS=off
PAYMENT_STUB_RPS=20
# Chaos scenario when PAYMENT_CHAOS=on: random | duplicate | delay | reorder | drop
PAYMENT_CHAOS_SCENARIO=random
# Number of api replicas (the stub's per-instance fallback limiter splits its rate by this)
API_INSTANCES=2
# Per-instance Postgres connection pool size
DB_POOL_SIZE=20
# SMTP mail stub
SMTP_HOST=mailstub
SMTP_PORT=1025
MAIL_FROM=tickets@example.test
# Test-only controls (time offset). NEVER enable in production.
ENABLE_TEST_CONTROLS=false
# Queue
QUEUE_MAX_SELECTORS=200
QUEUE_TRIGGER_THRESHOLD=500

# Host port for postgres (change if a local Postgres already uses 5432)
POSTGRES_HOST_PORT=5432
